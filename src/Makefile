		model/random.h \
		model/parameter.h \
		model/ca.h \
		model/mainpage.h \
		model/graph.h \
		model/cell.h \
		model/dish.h \
		model/sqr.h \
		model/crash.h \
		model/hull.h \
		model/connections.h \
		model/fft.h \
		model/init.xpm
